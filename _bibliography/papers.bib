@article{dashdamirov2026drill,
  abbr        = {Under Review},
  bibtex_show = {true},
  title       = {Where Will They Drill? Random Survival Forests for Spatially Dependent Event Prediction},
  author      = {Dashdamirov, Dursun and Belivanis, Dimitrios and Zhao, Peidong and Stewart, Jeff and Foster, John T. and Pyrcz, Michael J.},
  year        = {2026},
  journal     = {Geoenergy Science and Engineering},
  note        = {Under review},
  abstract    = {Forecasting drilling activity in unconventional reservoirs is essential for infrastructure planning, logistical coordination, and regional economic management. While operators maintain internal schedules, predicting activity remains challenging for external stakeholders due to the nonpublic nature of corporate strategies and limited access to proprietary geological data. This work addresses the challenge by framing drilling expansion as a spatiotemporal time-to-event prediction problem. We propose an end-to-end framework that integrates spatial dependencies with survival analysis to estimate the cumulative probability of drilling over a multiyear horizon. Spatial and temporal feature aggregation scales are derived directly from indicator variogram analysis, and engineered features explicitly encode spatial dependence, such as distance to the drilling front and local angular coverage. Validated on a two-decade dataset from the Eagle Ford Shale, the proposed model achieves a concordance index of 0.78. Beyond the case study, the methodology offers a generalized foundation for high-dimensional spatial time-to-event problems in subsurface engineering and other domains such as urban expansion and environmental hazard propagation.},
  selected    = {true}
}

